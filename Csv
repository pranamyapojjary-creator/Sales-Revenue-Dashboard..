<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sales & Revenue Analysis Dashboard</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #f4f7fb;
            color: #172033;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: #132238;
            color: white;
            padding: 28px 18px;
            z-index: 10;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            padding: 0 15px 35px;
        }

        .logo span {
            color: #2f80ed;
        }

        .menu-title {
            color: #8390a5;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 0 15px 12px;
        }

        .menu {
            list-style: none;
        }

        .menu li {
            margin-bottom: 7px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 15px;
            color: #b9c4d4;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s;
        }

        .menu a:hover,
        .menu a.active {
            background: #246bce;
            color: white;
        }

        .menu-icon {
            width: 20px;
            text-align: center;
            font-size: 17px;
        }

        /* =========================
           MAIN
        ========================= */

        .main {
            margin-left: 250px;
            padding: 30px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
        }

        .page-title h1 {
            font-size: 28px;
            font-weight: 800;
            color: #172033;
        }

        .page-title p {
            margin-top: 6px;
            color: #7b8798;
            font-size: 14px;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 12px;
            background: white;
            padding: 8px 15px 8px 8px;
            border-radius: 30px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #2f80ed;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .user-info strong {
            display: block;
            font-size: 13px;
        }

        .user-info span {
            color: #8a95a5;
            font-size: 11px;
        }

        /* =========================
           FILTERS
        ========================= */

        .filters {
            background: white;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 22px;
            display: flex;
            gap: 15px;
            align-items: end;
            flex-wrap: wrap;
            box-shadow: 0 3px 18px rgba(25, 45, 75, 0.05);
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .filter-group label {
            font-size: 12px;
            color: #657186;
            font-weight: 600;
        }

        select,
        input {
            border: 1px solid #dce2eb;
            background: #fff;
            padding: 10px 13px;
            min-width: 160px;
            border-radius: 8px;
            color: #253044;
            outline: none;
            font-family: inherit;
        }

        select:focus,
        input:focus {
            border-color: #2f80ed;
        }

        .reset-btn {
            border: none;
            background: #eef4ff;
            color: #246bce;
            padding: 11px 18px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
        }

        .reset-btn:hover {
            background: #dceaff;
        }

        /* =========================
           KPI CARDS
        ========================= */

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 22px;
        }

        .kpi-card {
            background: white;
            border-radius: 14px;
            padding: 21px;
            box-shadow: 0 3px 18px rgba(25, 45, 75, 0.05);
            position: relative;
            overflow: hidden;
        }

        .kpi-card::after {
            content: "";
            position: absolute;
            right: -25px;
            bottom: -35px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(47, 128, 237, 0.06);
        }

        .kpi-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .kpi-label {
            color: #7b8798;
            font-size: 13px;
            font-weight: 500;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .blue {
            background: #eaf2ff;
            color: #2f80ed;
        }

        .green {
            background: #e9faf2;
            color: #20a66a;
        }

        .orange {
            background: #fff4e5;
            color: #ef9a22;
        }

        .purple {
            background: #f1edff;
            color: #7b61d9;
        }

        .kpi-value {
            margin-top: 13px;
            font-size: 26px;
            font-weight: 800;
            color: #172033;
        }

        .growth {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #20a66a;
        }

        .growth.down {
            color: #e05252;
        }

        /* =========================
           CHART GRID
        ========================= */

        .chart-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .chart-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 3px 18px rgba(25, 45, 75, 0.05);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .chart-title {
            font-size: 16px;
            font-weight: 700;
            color: #172033;
        }

        .chart-subtitle {
            color: #8994a5;
            font-size: 11px;
            margin-top: 5px;
        }

        .chart-container {
            height: 290px;
            position: relative;
        }

        /* =========================
           BOTTOM GRID
        ========================= */

        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        /* =========================
           TABLE
        ========================= */

        .table-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 3px 18px rgba(25, 45, 75, 0.05);
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }

        th {
            color: #8994a5;
            font-size: 11px;
            text-align: left;
            padding: 12px 8px;
            border-bottom: 1px solid #edf0f4;
            font-weight: 600;
        }

        td {
            padding: 14px 8px;
            border-bottom: 1px solid #f0f2f5;
            font-size: 12px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .product-name {
            font-weight: 600;
            color: #263147;
        }

        .category {
            background: #eef4ff;
            color: #286dcc;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
        }

        .amount {
            font-weight: 700;
        }

        /* =========================
           FOOTER
        ========================= */

        .footer {
            text-align: center;
            color: #98a2b1;
            font-size: 11px;
            padding: 25px 0 5px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 1100px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }

            .bottom-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 750px) {
            .sidebar {
                width: 70px;
                padding: 20px 8px;
            }

            .logo {
                font-size: 0;
                text-align: center;
                padding: 0 0 30px;
            }

            .logo span {
                font-size: 22px;
            }

            .menu-title,
            .menu a span:not(.menu-icon) {
                display: none;
            }

            .menu a {
                justify-content: center;
                padding: 13px 5px;
            }

            .main {
                margin-left: 70px;
                padding: 18px;
            }

            .topbar {
                align-items: flex-start;
            }

            .page-title h1 {
                font-size: 21px;
            }

            .user-info {
                display: none;
            }

            .filters {
                align-items: stretch;
                flex-direction: column;
            }

            select,
            input {
                width: 100%;
            }

            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="logo">
            Sales<span>Pro</span>
        </div>

        <div class="menu-title">
            Main Menu
        </div>

        <ul class="menu">

            <li>
                <a href="#" class="active">
                    <span class="menu-icon">📊</span>
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span class="menu-icon">💰</span>
                    <span>Sales</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span class="menu-icon">📦</span>
                    <span>Products</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span class="menu-icon">👥</span>
                    <span>Customers</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span class="menu-icon">📈</span>
                    <span>Reports</span>
                </a>
            </li>

        </ul>

        <div class="menu-title" style="margin-top: 30px;">
            Settings
        </div>

        <ul class="menu">

            <li>
                <a href="#">
                    <span class="menu-icon">⚙️</span>
                    <span>Settings</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span class="menu-icon">❓</span>
                    <span>Help</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main class="main">

        <!-- TOP BAR -->

        <div class="topbar">

            <div class="page-title">

                <h1>Sales & Revenue Analysis</h1>

                <p>
                    Monitor your business performance and sales trends
                </p>

            </div>

            <div class="user">

                <div class="avatar">
                    JD
                </div>

                <div class="user-info">
                    <strong>John Doe</strong>
                    <span>Administrator</span>
                </div>

            </div>

        </div>


        <!-- =========================
             FILTERS
        ========================== -->

        <section class="filters">

            <div class="filter-group">

                <label for="dateFilter">
                    Date Range
                </label>

                <select id="dateFilter">
                    <option value="all">All Time</option>
                    <option value="2026">2026</option>
                    <option value="2025">2025</option>
                </select>

            </div>


            <div class="filter-group">

                <label for="categoryFilter">
                    Category
                </label>

                <select id="categoryFilter">

                    <option value="all">
                        All Categories
                    </option>

                    <option value="Electronics">
                        Electronics
                    </option>

                    <option value="Clothing">
                        Clothing
                    </option>

                    <option value="Home">
                        Home & Garden
                    </option>

                    <option value="Sports">
                        Sports
                    </option>

                </select>

            </div>


            <div class="filter-group">

                <label for="productFilter">
                    Product
                </label>

                <select id="productFilter">

                    <option value="all">
                        All Products
                    </option>

                    <option value="Laptop">
                        Laptop
                    </option>

                    <option value="Headphones">
                        Headphones
                    </option>

                    <option value="Smartphone">
                        Smartphone
                    </option>

                    <option value="T-Shirt">
                        T-Shirt
                    </option>

                    <option value="Shoes">
                        Shoes
                    </option>

                    <option value="Chair">
                        Chair
                    </option>

                    <option value="Table">
                        Table
                    </option>

                    <option value="Football">
                        Football
                    </option>

                </select>

            </div>


            <button class="reset-btn" onclick="resetFilters()">
                Reset Filters
            </button>

        </section>


        <!-- =========================
             KPI CARDS
        ========================== -->

        <section class="kpi-grid">

            <div class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-label">
                        Total Sales
                    </span>

                    <div class="kpi-icon blue">
                        💰
                    </div>

                </div>

                <div class="kpi-value" id="totalSales">
                    $0
                </div>

                <div class="growth">
                    ↑ 12.5% vs last period
                </div>

            </div>


            <div class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-label">
                        Total Revenue
                    </span>

                    <div class="kpi-icon green">
                        📈
                    </div>

                </div>

                <div class="kpi-value" id="totalRevenue">
                    $0
                </div>

                <div class="growth">
                    ↑ 8.4% vs last period
                </div>

            </div>


            <div class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-label">
                        Total Orders
                    </span>

                    <div class="kpi-icon orange">
                        🛒
                    </div>

                </div>

                <div class="kpi-value" id="totalOrders">
                    0
                </div>

                <div class="growth">
                    ↑ 6.8% vs last period
                </div>

            </div>


            <div class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-label">
                        Average Order Value
                    </span>

                    <div class="kpi-icon purple">
                        📊
                    </div>

                </div>

                <div class="kpi-value" id="averageOrder">
                    $0
                </div>

                <div class="growth">
                    ↑ 4.2% vs last period
                </div>

            </div>

        </section>


        <!-- =========================
             CHARTS
        ========================== -->

        <section class="chart-grid">

            <!-- Revenue Trend -->

            <div class="chart-card">

                <div class="chart-header">

                    <div>

                        <div class="chart-title">
                            Revenue Trend
                        </div>

                        <div class="chart-subtitle">
                            Monthly revenue performance
                        </div>

                    </div>

                </div>

                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>

            </div>


            <!-- Category Chart -->

            <div class="chart-card">

                <div class="chart-header">

                    <div>

                        <div class="chart-title">
                            Sales by Category
                        </div>

                        <div class="chart-subtitle">
                            Revenue distribution
                        </div>

                    </div>

                </div>

                <div class="chart-container">
         
